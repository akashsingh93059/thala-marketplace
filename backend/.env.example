# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://localhost:27017/divi
# Use a long random string in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Bcrypt cost factor (10 dev, 12 production)
BCRYPT_ROUNDS=10

# === Google Sign-In (free) ===
# Set up at https://console.cloud.google.com/ -> Credentials -> OAuth client ID -> Web application
# Add http://localhost:5500 to "Authorized JavaScript origins". Paste the Client ID here.
GOOGLE_CLIENT_ID=
